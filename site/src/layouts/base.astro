---
import '../styles/global.css';
import Sidebar from '../components/sidebar.astro';
import ShareSidebar from '../components/share-sidebar.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/date';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  share?: boolean;
}

const {
  title,
  description = '一个人的学习日志。一路走，一路堆石头。',
  currentId,
  share = false,
} = Astro.props;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const latest = posts[0];
const meta = share
  ? '3 个分享'
  : latest
    ? `${posts.length} 篇 · 最后更新 ${formatDate(latest.data.date)}`
    : '还没有文章';

const pageTitle = title ? `${title} · CAIRN` : 'CAIRN · 一路走，一路堆石头';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0d11" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand">
          <a class="logo" href="/">CAIRN</a>
          <span class="tagline">一路走，一路堆石头</span>
        </div>

        <nav class="section-nav" aria-label="版块">
          <a
            class:list={['section-link', { active: !share }]}
            href="/"
            aria-current={share ? undefined : 'page'}
          >
            文章
          </a>
          <a
            class:list={['section-link', { active: share }]}
            href="/share/"
            aria-current={share ? 'page' : undefined}
          >
            分享
          </a>
        </nav>

        <span class="header-meta">{meta}</span>
      </div>
    </header>

    <div class="shell">
      {share ? <ShareSidebar /> : <Sidebar posts={posts} currentId={currentId} />}

      <div class="content">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} CAIRN</span>
        </footer>
      </div>
    </div>
  </body>
</html>
