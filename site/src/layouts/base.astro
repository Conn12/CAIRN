---
import '../styles/global.css';
import Sidebar from '../components/sidebar.astro';
import ShareSidebar from '../components/share-sidebar.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/date';
import { shareCount } from '../data/shares';
import { modelCount } from '../data/models';

type Section = 'articles' | 'share' | 'learning' | 'models';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  section?: Section;
  meta?: string;
  bare?: boolean;
}

const {
  title,
  description = '一个人的学习日志。一路走，一路堆石头。',
  currentId,
  section = 'articles',
  meta,
  bare = false,
} = Astro.props;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const latest = posts[0];
const headerMeta =
  meta ??
  (section === 'share'
    ? `${shareCount} 个分享`
    : section === 'models'
    ? `${modelCount} 个模型`
    : latest
      ? `${posts.length} 篇 · 最后更新 ${formatDate(latest.data.date)}`
      : '还没有文章');

const pageTitle = title ? `${title} · CAIRN` : 'CAIRN · 一路走，一路堆石头';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0d11" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={`section-${section}`}>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand">
          <a class="logo" href="/">CAIRN</a>
          <span class="tagline">一路走，一路堆石头</span>
        </div>

        <nav class="section-nav" aria-label="版块">
          <a
            class:list={['section-link', { active: section === 'articles' }]}
            href="/"
            aria-current={section === 'articles' ? 'page' : undefined}
          >
            文章
          </a>
          <a
            class:list={['section-link', { active: section === 'share' }]}
            href="/share/"
            aria-current={section === 'share' ? 'page' : undefined}
          >
            分享
          </a>
          <a
            class:list={['section-link', { active: section === 'learning' }]}
            href="/learning/"
            aria-current={section === 'learning' ? 'page' : undefined}
          >
            学习
          </a>
          <a
            class:list={['section-link', { active: section === 'models' }]}
            href="/models/"
            aria-current={section === 'models' ? 'page' : undefined}
          >
            物理模型
          </a>
        </nav>

        <span class="header-meta">{headerMeta}</span>
      </div>
    </header>

    {
      bare ? (
        <slot />
      ) : (
        <div class="shell">
          {Astro.slots.has('sidebar') ? (
            <slot name="sidebar" />
          ) : section === 'share' ? (
            <ShareSidebar />
          ) : (
            <Sidebar posts={posts} currentId={currentId} />
          )}

          <div class="content">
            <main>
              <slot />
            </main>
            <footer class="site-footer">
              <span>© {new Date().getFullYear()} CAIRN</span>
            </footer>
          </div>
        </div>
      )
    }
  </body>
</html>
