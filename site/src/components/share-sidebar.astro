---
import ShareNav from './share-nav.astro';
import { shareCount } from '../data/shares';
---

<aside class="sidebar">
  <details class="sidebar-mobile">
    <summary>
      <span>分享分类</span>
      <span class="count">{shareCount}</span>
    </summary>
    <nav aria-label="分享分类">
      <ShareNav />
    </nav>
  </details>

  <nav class="sidebar-nav" aria-label="分享分类">
    <p class="nav-label">
      <span>分享</span>
      <span class="count">{shareCount}</span>
    </p>
    <ShareNav />
  </nav>
</aside>
