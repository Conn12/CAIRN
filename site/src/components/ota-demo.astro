    font-family: var(--mono);
    font-size: 0.66rem;
    line-height: 1.65;
    color: var(--dim);
  }

  .ota-log li {
    display: flex;
    gap: 0.6rem;
  }

  .ota-log li span {
    flex: 0 0 auto;
    color: var(--gold-dim);
  }

  .ota-note {
    margin-top: 0.75rem;
    font-size: 0.65rem;
    line-height: 1.6;
    color: var(--faint);
  }

  .ota-note code {
    font-size: 0.9em;
  }

  @media (max-width: 560px) {
    .ota-node-status {
      position: static;
      display: block;
      margin-top: 0.35rem;
    }

    .ota-link {
      height: 38px;
    }
  }

</style>
