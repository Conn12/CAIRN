<div class="ota-3d" data-ota-3d>
  <div class="ota-3d-canvas" data-canvas></div>

  <div class="ota-3d-ui">
    <div class="ota-3d-top">
      <div class="ota-3d-panel ota-3d-status-panel">
        <span class="ota-3d-kicker">CAIRN / OTA</span>
        <p class="ota-3d-status" data-status>待机</p>
      </div>

      <div class="ota-3d-panel ota-3d-specs">
        <span>EXT <b>W25Q32 · 4 MB</b></span>
        <span>APP <b>0x08008000 · 96 KB</b></span>
        <span>AES <b>AES-256-CBC</b></span>
      </div>
    </div>

    <div class="ota-3d-bottom">
      <div class="ota-3d-panel ota-3d-caption-panel">
        <p class="ota-3d-caption" data-caption>等待固件...</p>
        <div class="ota-3d-progress" aria-hidden="true">
          <span data-progress></span>
        </div>
      </div>
      <button type="button" class="ota-3d-btn" data-replay>重播</button>
    </div>
  </div>

  <p class="ota-3d-fallback">当前浏览器不支持 WebGL，3D 场景无法显示。</p>
</div>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import {
    CSS2DObject,
    CSS2DRenderer,
  } from 'three/addons/renderers/CSS2DRenderer.js';

  const root = document.querySelector('[data-ota-3d]');

  if (root) {
    const canvasHost = root.querySelector('[data-canvas]');
    const statusEl = root.querySelector('[data-status]');
    const captionEl = root.querySelector('[data-caption]');
    const progressEl = root.querySelector('[data-progress]');
    const replayBtn = root.querySelector('[data-replay]');

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({
        antialias: true,
        alpha: true,
      });
    } catch {
      root.classList.add('is-failed');
    }

    if (renderer) {
      const isNarrow = window.innerWidth < 640;
      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(0x07090d, 16, 42);

      const camera = new THREE.PerspectiveCamera(
        isNarrow ? 48 : 38,
        1,
        0.1,
        100,
      );
      camera.position.set(0, isNarrow ? 8 : 6.2, isNarrow ? 16.5 : 14.5);

      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;

      renderer.domElement.style.display = 'block';
      renderer.domElement.style.width = '100%';
      renderer.domElement.style.height = '100%';
      canvasHost.appendChild(renderer.domElement);

      const labelRenderer = new CSS2DRenderer();
      labelRenderer.domElement.style.position = 'absolute';
      labelRenderer.domElement.style.inset = '0';
      labelRenderer.domElement.style.pointerEvents = 'none';
      labelRenderer.domElement.style.zIndex = '1';
      canvasHost.appendChild(labelRenderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.enablePan = false;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.35;
      controls.minDistance = 9;
      controls.maxDistance = 26;
      controls.maxPolarAngle = Math.PI * 0.48;
      controls.target.set(0, isNarrow ? 2.2 : 1.5, 0);

      scene.add(new THREE.AmbientLight(0xffffff, 0.35));
      scene.add(new THREE.HemisphereLight(0x7dcfff, 0x0b0d11, 0.45));

      const keyLight = new THREE.DirectionalLight(0xffffff, 0.85);
      keyLight.position.set(5, 10, 7);
      scene.add(keyLight);

      const cyanLight = new THREE.PointLight(0x7dcfff, 26, 22, 2);
      cyanLight.position.set(-5, 6, 5);
      scene.add(cyanLight);

      const orangeLight = new THREE.PointLight(0xff9e64, 18, 18, 2);
      orangeLight.position.set(5, 4, -3);
      scene.add(orangeLight);

      const glowTexture = (() => {
        const canvas = document.createElement('canvas');
        canvas.width = 128;
        canvas.height = 128;
        const ctx = canvas.getContext('2d');
        const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
        gradient.addColorStop(0, 'rgba(255,255,255,1)');
        gradient.addColorStop(0.35, 'rgba(255,255,255,0.45)');
        gradient.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 128, 128);
        return new THREE.CanvasTexture(canvas);
      })();

      const addGlow = (color, size, position, opacity) => {
        const material = new THREE.SpriteMaterial({
          map: glowTexture,
          color,
          transparent: true,
          opacity,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        });
        const sprite = new THREE.Sprite(material);
        sprite.scale.set(size, size, 1);
        sprite.position.copy(position);
        scene.add(sprite);
        return sprite;
      };

      const addEdges = (mesh, color, opacity) => {
        const edges = new THREE.LineSegments(
          new THREE.EdgesGeometry(mesh.geometry),
          new THREE.LineBasicMaterial({
            color,
            transparent: true,
            opacity,
          }),
        );
        mesh.add(edges);
        return edges;
      };

      const secondaryLabels = [];

      const addLabel = (parent, text, position, size = 10) => {
        const div = document.createElement('div');
        div.textContent = text;
        div.style.cssText = `font-family:ui-monospace,Consolas,monospace;font-size:${size}px;letter-spacing:0.12em;color:#7dcfff;text-shadow:0 0 8px rgba(125,207,255,0.55);white-space:nowrap;pointer-events:none;`;
        const label = new CSS2DObject(div);
        label.position.copy(position);
        parent.add(label);
        return label;
      };

      // 底板
      const board = new THREE.Mesh(
        new THREE.BoxGeometry(9, 0.18, 6),
        new THREE.MeshStandardMaterial({
          color: 0x0b0f14,
          metalness: 0.7,
          roughness: 0.45,
        }),
      );
      board.position.y = 0;
      scene.add(board);
      addEdges(board, 0x7dcfff, 0.12);

      const grid = new THREE.GridHelper(9, 18, 0x1f2a35, 0x151b24);
      grid.position.y = 0.12;
      grid.material.transparent = true;
      grid.material.opacity = 0.35;
      scene.add(grid);

      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(3.9, 0.012, 8, 160),
        new THREE.MeshBasicMaterial({
          color: 0x7dcfff,
          transparent: true,
          opacity: 0.28,
        }),
      );
      ring.rotation.x = Math.PI / 2;
      ring.position.y = 0.13;
      scene.add(ring);

      const goldRing = new THREE.Mesh(
        new THREE.TorusGeometry(4.3, 0.01, 8, 160),
        new THREE.MeshBasicMaterial({
          color: 0xe8b96a,
          transparent: true,
          opacity: 0.16,
        }),
      );
      goldRing.rotation.x = Math.PI / 2;
      goldRing.position.y = 0.13;
      scene.add(goldRing);

      addGlow(0x7dcfff, 13, new THREE.Vector3(0, 2.4, -3.5), 0.06);
      addGlow(0xff9e64, 8, new THREE.Vector3(2.8, 1.2, 1.4), 0.04);

      // 星尘
      const starGeometry = new THREE.BufferGeometry();
      const starPositions = new Float32Array(900 * 3);
      for (let index = 0; index < 900; index += 1) {
        const radius = 12 + Math.random() * 18;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        starPositions[index * 3] = radius * Math.sin(phi) * Math.cos(theta);
        starPositions[index * 3 + 1] = radius * Math.cos(phi) * 0.5 + 4;
        starPositions[index * 3 + 2] = radius * Math.sin(phi) * Math.sin(theta);
      }
      starGeometry.setAttribute(
        'position',
        new THREE.BufferAttribute(starPositions, 3),
      );
      const stars = new THREE.Points(
        starGeometry,
        new THREE.PointsMaterial({
          color: 0x7dcfff,
          size: 0.035,
          transparent: true,
          opacity: 0.55,
          sizeAttenuation: true,
        }),
      );
      scene.add(stars);

      // 外部 Flash 芯片
      const ext = new THREE.Group();
      ext.position.set(-2.4, 2.4, 0.4);
      scene.add(ext);

      const extBody = new THREE.Mesh(
        new THREE.BoxGeometry(2.2, 0.35, 1.8),
        new THREE.MeshStandardMaterial({
          color: 0x11161e,
          metalness: 0.6,
          roughness: 0.35,
        }),
      );
      ext.add(extBody);
      addEdges(extBody, 0x7dcfff, 0.45);

      const pinMaterial = new THREE.MeshStandardMaterial({
        color: 0xc9a25a,
        metalness: 0.9,
        roughness: 0.25,
      });

      for (let index = 0; index < 5; index += 1) {
        const t = (index + 0.5) / 5;
        for (const side of [-1, 1]) {
          const pinA = new THREE.Mesh(
            new THREE.BoxGeometry(0.08, 0.04, 0.18),
            pinMaterial,
          );
          pinA.position.set(-1.1 + t * 2.2, 0.05, side * 0.99);
          ext.add(pinA);

          const pinB = new THREE.Mesh(
            new THREE.BoxGeometry(0.18, 0.04, 0.08),
            pinMaterial,
          );
          pinB.position.set(side * 1.19, 0.05, -0.9 + t * 1.8);
          ext.add(pinB);
        }
      }

      const extCellMaterials = [];
      for (let row = 0; row < 4; row += 1) {
        for (let column = 0; column < 4; column += 1) {
          const material = new THREE.MeshStandardMaterial({
            color: 0x1a2029,
            metalness: 0.3,
            roughness: 0.6,
            emissive: 0x000000,
            emissiveIntensity: 0,
          });
          const cell = new THREE.Mesh(
            new THREE.BoxGeometry(0.28, 0.03, 0.28),
            material,
          );
          cell.position.set(
            (column - 1.5) * 0.35,
            0.185,
            (row - 1.5) * 0.35,
          );
          ext.add(cell);
          extCellMaterials.push(material);
        }
      }

      addGlow(0x7dcfff, 3.4, new THREE.Vector3(-2.4, 2.4, 0.4), 0.16);
      addLabel(ext, 'W25Q32', new THREE.Vector3(0, 0.8, 0));

      // 内部 Flash / STM32
      const int = new THREE.Group();
      int.position.set(0.6, 0.38, -0.2);
      scene.add(int);

      const intBody = new THREE.Mesh(
        new THREE.BoxGeometry(3, 0.45, 2.2),
        new THREE.MeshStandardMaterial({
          color: 0x11161e,
          metalness: 0.65,
          roughness: 0.3,
        }),
      );
      int.add(intBody);
      addEdges(intBody, 0xe8b96a, 0.35);

      for (let index = 0; index < 6; index += 1) {
        const t = (index + 0.5) / 6;
        for (const side of [-1, 1]) {
          const pinA = new THREE.Mesh(
            new THREE.BoxGeometry(0.09, 0.04, 0.2),
            pinMaterial,
          );
          pinA.position.set(-1.5 + t * 3, 0.06, side * 1.19);
          int.add(pinA);

          const pinB = new THREE.Mesh(
            new THREE.BoxGeometry(0.2, 0.04, 0.09),
            pinMaterial,
          );
          pinB.position.set(side * 1.59, 0.06, -1.1 + t * 2.2);
          int.add(pinB);
        }
      }

      const intCellMaterials = [];
      for (let row = 0; row < 2; row += 1) {
        for (let column = 0; column < 4; column += 1) {
          const material = new THREE.MeshStandardMaterial({
            color: 0x1a2029,
            metalness: 0.3,
            roughness: 0.6,
            emissive: 0x000000,
            emissiveIntensity: 0,
          });
          const cell = new THREE.Mesh(
            new THREE.BoxGeometry(0.38, 0.03, 0.42),
            material,
          );
          cell.position.set(
            (column - 1.5) * 0.62,
            0.245,
            (row - 0.5) * 0.62,
          );
          int.add(cell);
          intCellMaterials.push(material);
        }
      }

      addGlow(0xe8b96a, 3.8, new THREE.Vector3(0.6, 0.8, -0.2), 0.12);
      addLabel(int, 'STM32 · APP', new THREE.Vector3(0, 0.9, 0));

      // Bootloader 小芯片
      const boot = new THREE.Group();
      boot.position.set(-2.1, 0.25, -1.9);
      scene.add(boot);

      const bootBody = new THREE.Mesh(
        new THREE.BoxGeometry(1.3, 0.25, 1),
        new THREE.MeshStandardMaterial({
          color: 0x0f141b,
          metalness: 0.55,
          roughness: 0.45,
        }),
      );
      boot.add(bootBody);
      addEdges(bootBody, 0xe8b96a, 0.3);

      // APP LED
      const app = new THREE.Group();
      app.position.set(3.4, 0.35, 1.2);
      scene.add(app);

      const appBase = new THREE.Mesh(
        new THREE.CylinderGeometry(0.24, 0.28, 0.16, 24),
        new THREE.MeshStandardMaterial({
          color: 0x11161e,
          metalness: 0.7,
          roughness: 0.35,
        }),
      );
      app.add(appBase);
      addEdges(appBase, 0x7dcfff, 0.3);

      const ledMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a2029,
        emissive: 0x9ece6a,
        emissiveIntensity: 0,
        metalness: 0.2,
        roughness: 0.3,
      });
      const led = new THREE.Mesh(
        new THREE.SphereGeometry(0.13, 20, 20),
        ledMaterial,
      );
      led.position.y = 0.16;
      app.add(led);

      const ledLight = new THREE.PointLight(0x9ece6a, 0, 5, 2);
      ledLight.position.y = 0.16;
      app.add(ledLight);

      addGlow(0x9ece6a, 1.6, new THREE.Vector3(3.4, 0.55, 1.2), 0.08);

      // 上位机
      const source = new THREE.Group();
      source.position.set(-4.6, 4.2, 1.6);
      scene.add(source);

      const sourceCore = new THREE.Mesh(
        new THREE.IcosahedronGeometry(0.18, 0),
        new THREE.MeshBasicMaterial({ color: 0xe8b96a }),
      );
      source.add(sourceCore);

      const sourceRing = new THREE.Mesh(
        new THREE.TorusGeometry(0.45, 0.012, 8, 64),
        new THREE.MeshBasicMaterial({
          color: 0x7dcfff,
          transparent: true,
          opacity: 0.65,
        }),
      );
      sourceRing.rotation.x = 1.1;
      source.add(sourceRing);

      const sourceRing2 = new THREE.Mesh(
        new THREE.TorusGeometry(0.62, 0.008, 8, 64),
        new THREE.MeshBasicMaterial({
          color: 0xe8b96a,
          transparent: true,
          opacity: 0.35,
        }),
      );
      sourceRing2.rotation.y = 1.2;
      source.add(sourceRing2);

      if (!isNarrow) {
        const sourceLabel = addLabel(
          source,
          '上位机 · YMODEM',
          new THREE.Vector3(0, 0.8, 0),
          9,
        );
        secondaryLabels.push(sourceLabel.element);
      }

      // AES 解密核心
      const core = new THREE.Group();
      core.position.set(-0.8, 3.4, 1.2);
      scene.add(core);

      const coreMaterial = new THREE.MeshStandardMaterial({
        color: 0x0b131a,
        emissive: 0x7dcfff,
        emissiveIntensity: 0.25,
        metalness: 0.7,
        roughness: 0.25,
      });
      const coreMesh = new THREE.Mesh(
        new THREE.IcosahedronGeometry(0.38, 0),
        coreMaterial,
      );
      core.add(coreMesh);

      const coreWire = new THREE.Mesh(
        new THREE.IcosahedronGeometry(0.44, 0),
        new THREE.MeshBasicMaterial({
          color: 0x7dcfff,
          wireframe: true,
          transparent: true,
          opacity: 0.45,
        }),
      );
      core.add(coreWire);

      const coreRing = new THREE.Mesh(
        new THREE.TorusGeometry(0.6, 0.012, 8, 72),
        new THREE.MeshBasicMaterial({
          color: 0x7dcfff,
          transparent: true,
          opacity: 0.4,
        }),
      );
      coreRing.rotation.x = 1.1;
      core.add(coreRing);

      const coreRing2 = new THREE.Mesh(
        new THREE.TorusGeometry(0.76, 0.008, 8, 72),
        new THREE.MeshBasicMaterial({
          color: 0xe8b96a,
          transparent: true,
          opacity: 0.3,
        }),
      );
      coreRing2.rotation.y = 1.2;
      core.add(coreRing2);

      if (!isNarrow) {
        const coreLabel = addLabel(
          core,
          'AES-256-CBC',
          new THREE.Vector3(0, 1, 0),
          9,
        );
        secondaryLabels.push(coreLabel.element);
      }

      addGlow(0x7dcfff, 2.4, new THREE.Vector3(-0.8, 3.4, 1.2), 0.1);

      // 传输路径
      const makeCurve = (points) =>
        new THREE.CatmullRomCurve3(
          points.map(([x, y, z]) => new THREE.Vector3(x, y, z)),
        );

      const curve1 = makeCurve([
        [-4.6, 4.2, 1.6],
        [-3.7, 3.7, 1.2],
        [-3.1, 3.2, 0.8],
        [-2.4, 2.9, 0.4],
      ]);

      const curve2 = makeCurve([
        [-2.4, 2.2, 0.4],
        [-1.8, 2.9, 0.8],
        [-0.8, 3.4, 1.2],
        [-0.2, 2.4, 0.5],
        [0.2, 1.4, 0.1],
        [0.6, 0.95, -0.2],
      ]);

      const curve3 = makeCurve([
        [0.6, 0.95, -0.2],
        [1.6, 0.8, 0.3],
        [2.6, 0.7, 0.8],
        [3.4, 0.65, 1.2],
      ]);

      const addPath = (curve, color, opacity) => {
        const tube = new THREE.Mesh(
          new THREE.TubeGeometry(curve, 80, 0.012, 6, false),
          new THREE.MeshBasicMaterial({
            color,
            transparent: true,
            opacity,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
          }),
        );
        scene.add(tube);
      };

      addPath(curve1, 0x7dcfff, 0.26);
      addPath(curve2, 0x7dcfff, 0.22);
      addPath(curve3, 0xe8b96a, 0.22);

      const packetGeometry = new THREE.OctahedronGeometry(0.09, 0);
      const packetGroups = [];

      [curve1, curve2, curve3].forEach((curve, curveIndex) => {
        const group = new THREE.Group();
        group.visible = false;
        scene.add(group);

        const color = curveIndex === 2 ? 0xe8b96a : 0xffb46a;
        const packets = [];

        for (let index = 0; index < 5; index += 1) {
          const mesh = new THREE.Mesh(
            packetGeometry,
            new THREE.MeshBasicMaterial({ color }),
          );

          const halo = new THREE.Sprite(
            new THREE.SpriteMaterial({
              map: glowTexture,
              color,
              transparent: true,
              opacity: 0.65,
              blending: THREE.AdditiveBlending,
              depthWrite: false,
            }),
          );
          halo.scale.set(0.32, 0.32, 1);
          mesh.add(halo);

          group.add(mesh);
          packets.push({
            mesh,
            offset: index / 5,
            speed: 0.05 + curveIndex * 0.008,
          });
        }

        packetGroups.push({ group, packets, curve });
      });

      // 时间线
      let token = 0;
      let phase = 'idle';

      const setPhase = (name) => {
        phase = name;
        packetGroups[0].group.visible =
          name === 'receive' || name === 'write';
        packetGroups[1].group.visible =
          name === 'decrypt' || name === 'install';
        packetGroups[2].group.visible =
          name === 'jump' || name === 'run';
        root.dataset.phase = name;
      };

      const setStatus = (status, caption, progress) => {
        statusEl.textContent = status;
        captionEl.textContent = caption;
        progressEl.style.width = `${progress}%`;
      };

      const setCell = (material) => {
        material.color.set(0xe8b96a);
        material.emissive.set(0xe8b96a);
        material.emissiveIntensity = 0.9;
      };

      const resetScene = () => {
        setPhase('idle');
        for (const material of extCellMaterials) {
          material.color.set(0x1a2029);
          material.emissive.set(0x000000);
          material.emissiveIntensity = 0;
        }
        for (const material of intCellMaterials) {
          material.color.set(0x1a2029);
          material.emissive.set(0x000000);
          material.emissiveIntensity = 0;
        }
        ledMaterial.emissiveIntensity = 0;
        ledLight.intensity = 0;
        statusEl.textContent = '待机';
        captionEl.textContent = '等待固件...';
        progressEl.style.width = '0%';
      };

      const sleep = (ms, id) =>
        new Promise((resolve, reject) => {
          setTimeout(() => {
            if (id === token) resolve();
            else reject(new Error('cancelled'));
          }, ms);
        });

      const play = async () => {
        const id = ++token;
        resetScene();

        try {
          setPhase('receive');
          setStatus('接收固件', 'YMODEM 分包接收', 8);
          await sleep(1400, id);

          setPhase('write');
          setStatus('写入外部 Flash', 'SPI1 → W25Q32 · 4 KB 扇区', 15);

          for (let index = 0; index < extCellMaterials.length; index += 1) {
            await sleep(90, id);
            setCell(extCellMaterials[index]);
            const percent =
              15 + ((index + 1) / extCellMaterials.length) * 25;
            progressEl.style.width = `${percent}%`;
          }

          setPhase('decrypt');
          setStatus('AES-256-CBC 解密', '读取加密包 · 不重置 IV', 48);
          await sleep(1500, id);

          setPhase('install');
          setStatus('写入内部 APP', '0x08008000 · 半字写入', 55);

          for (let index = 0; index < intCellMaterials.length; index += 1) {
            await sleep(150, id);
            setCell(intCellMaterials[index]);
            const percent =
              55 + ((index + 1) / intCellMaterials.length) * 30;
            progressEl.style.width = `${percent}%`;
          }

          setPhase('jump');
          setStatus('校验并跳转', 'VTOR / MSP / APP', 90);
          await sleep(900, id);

          setPhase('run');
          setStatus('APP 运行', 'LED2 / LED3 交替', 100);
          await sleep(2400, id);

          await sleep(1600, id);
          play();
        } catch {
          // 重播时取消上一轮
        }
      };

      replayBtn.addEventListener('click', () => {
        play();
      });

      // 渲染循环
      const clock = new THREE.Clock();
      let elapsed = 0;

      let lastNarrow = null;

      const resize = () => {
        const width = canvasHost.clientWidth;
        const height = canvasHost.clientHeight;
        if (width === 0 || height === 0) return;

        const narrow = width < 520;

        if (narrow !== lastNarrow) {
          lastNarrow = narrow;
          camera.fov = narrow ? 48 : 38;
          camera.position.set(
            0,
            narrow ? 8 : 6.2,
            narrow ? 16.5 : 14.5,
          );
          controls.target.set(0, narrow ? 2 : 1.5, 0);
          controls.update();

          for (const element of secondaryLabels) {
            element.style.display = narrow ? 'none' : '';
          }
        }

        renderer.setSize(width, height, false);
        labelRenderer.setSize(width, height);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      const observer = new ResizeObserver(resize);
      observer.observe(canvasHost);
      resize();

      const animate = () => {
        const delta = Math.min(clock.getDelta(), 0.05);
        elapsed += delta;

        controls.update();

        source.rotation.y += delta * 0.5;
        sourceRing.rotation.z += delta * 0.8;
        sourceRing2.rotation.x += delta * 0.4;

        core.rotation.y += delta * (phase === 'decrypt' ? 2.8 : 0.35);
        core.rotation.x += delta * 0.12;
        coreRing.rotation.z += delta * (phase === 'decrypt' ? 2 : 0.3);
        coreRing2.rotation.x += delta * 0.5;
        coreMaterial.emissiveIntensity =
          phase === 'decrypt'
            ? 1.1 + Math.sin(elapsed * 8) * 0.4
            : 0.22;
        coreWire.material.opacity = phase === 'decrypt' ? 0.85 : 0.35;

        ring.rotation.z += delta * 0.04;
        goldRing.rotation.z -= delta * 0.03;
        stars.rotation.y += delta * 0.004;

        for (const set of packetGroups) {
          if (!set.group.visible) continue;

          for (const packet of set.packets) {
            const t = (elapsed * packet.speed + packet.offset) % 1;
            packet.mesh.position.copy(set.curve.getPointAt(t));
            packet.mesh.rotation.x += delta * 1.8;
            packet.mesh.rotation.y += delta * 1.2;
          }
        }

        ledMaterial.emissiveIntensity =
          phase === 'run'
            ? 1.2 + Math.sin(elapsed * 6) * 0.9
            : 0;
        ledLight.intensity =
          phase === 'run'
            ? 1.4 + Math.sin(elapsed * 6) * 1.1
            : 0;

        renderer.render(scene, camera);
        labelRenderer.render(scene, camera);
      };

      renderer.setAnimationLoop(animate);
      play();
    }
  }
</script>

