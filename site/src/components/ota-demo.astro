<div class="ota-demo" data-ota>
  <div class="ota-head">
    <div class="ota-head-text">
      <span class="ota-kicker">最终流程演示</span>
      <p class="ota-step-title" data-ota-title>待开始</p>
    </div>
    <div class="ota-controls">
      <button type="button" class="ota-btn ota-btn-primary" data-ota-play>
        播放
      </button>
      <button type="button" class="ota-btn" data-ota-step>单步</button>
      <button type="button" class="ota-btn" data-ota-reset>重置</button>
    </div>
  </div>

  <div class="ota-progress" aria-hidden="true">
    <span data-ota-progress></span>
  </div>

  <div class="ota-flow">
    <div class="ota-node" data-node="pc">
      <div class="ota-node-head">
        <span class="ota-node-name">上位机</span>
        <span class="ota-node-tag">Tera Term</span>
      </div>
      <p class="ota-node-meta">加密包 · YMODEM</p>
      <span class="ota-node-status" data-status>等待</span>
    </div>

    <div class="ota-link" data-link="pc-boot">
      <span class="ota-link-label">USART1 · YMODEM</span>
      <i class="ota-packet"></i>
    </div>

    <div class="ota-node" data-node="boot">
      <div class="ota-node-head">
        <span class="ota-node-name">Bootloader</span>
        <span class="ota-node-tag">0x08000000 · 32 KB</span>
      </div>
      <p class="ota-node-meta">USART1 + SPI1 · 接收 / 解密 / 跳转</p>
      <span class="ota-node-status" data-status>等待</span>
    </div>

    <div class="ota-link" data-link="boot-ext">
      <span class="ota-link-label">SPI1 · 写入 / 读回</span>
      <i class="ota-packet"></i>
    </div>

    <div class="ota-node" data-node="ext">
      <div class="ota-node-head">
        <span class="ota-node-name">W25Q32 外部 Flash</span>
        <span class="ota-node-tag">4 MB</span>
      </div>
      <p class="ota-node-meta">暂存加密包 · 4 KB 扇区 / 256 B 页</p>
      <div class="ota-meter" aria-hidden="true">
        <span data-fill="ext"></span>
      </div>
      <span class="ota-node-status" data-status>等待</span>
    </div>

    <div class="ota-link" data-link="ext-int">
      <span class="ota-link-label">Bootloader 读取 · AES 解密 · 搬运</span>
      <i class="ota-packet"></i>
    </div>

    <div class="ota-node" data-node="int">
      <div class="ota-node-head">
        <span class="ota-node-name">内部 Flash APP 区</span>
        <span class="ota-node-tag">0x08008000 · 96 KB</span>
      </div>
      <p class="ota-node-meta">2 KB 页 / 半字写入 / 读回比对</p>
      <div class="ota-meter" aria-hidden="true">
        <span data-fill="int"></span>
      </div>
      <span class="ota-node-status" data-status>等待</span>
    </div>

    <div class="ota-link" data-link="int-app">
      <span class="ota-link-label">校验向量表 · 设置 VTOR / MSP</span>
      <i class="ota-packet"></i>
    </div>

    <div class="ota-node" data-node="app">
      <div class="ota-node-head">
        <span class="ota-node-name">APP 运行</span>
        <span class="ota-node-tag">_LED1</span>
      </div>
      <p class="ota-node-meta">LED2 / LED3 每 500 ms 交替</p>
      <span class="ota-node-status" data-status>等待</span>
    </div>
  </div>

  <div class="ota-log-wrap">
    <p class="ota-log-title">执行日志</p>
    <ol class="ota-log" data-ota-log aria-live="polite"></ol>
  </div>

  <p class="ota-note">
    按 <code>_07bootloader</code> 主流程简化绘制。当前代码未校验 YMODEM CRC；
    “读回”只代表写入后读回比对，不等于整包完整性校验。
  </p>
</div>

<script>
  const root = document.querySelector('[data-ota]');

  if (root) {
    const nodes = Object.fromEntries(
      [...root.querySelectorAll('[data-node]')].map((node) => [
        node.dataset.node,
        node,
      ]),
    );
    const links = Object.fromEntries(
      [...root.querySelectorAll('[data-link]')].map((link) => [
        link.dataset.link,
        link,
      ]),
    );

    const titleEl = root.querySelector('[data-ota-title]');
    const progressEl = root.querySelector('[data-ota-progress]');
    const logEl = root.querySelector('[data-ota-log]');
    const playBtn = root.querySelector('[data-ota-play]');
    const stepBtn = root.querySelector('[data-ota-step]');
    const resetBtn = root.querySelector('[data-ota-reset]');
    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const steps = [
      {
        node: 'pc',
        title: '生成加密包',
        log: '编译 _LED1 得到 BIN，加密工具封装成 16 字节头 + AES 正文。',
        status: '已生成',
        done: '已生成',
      },
      {
        node: 'pc',
        link: 'pc-boot',
        title: 'YMODEM 发送',
        log: 'Tera Term 通过 USART1（115200 8N1）发送加密包。',
        status: '发送中',
        done: '已发送',
      },
      {
        node: 'boot',
        title: 'Bootloader 接收',
        log: '首包解析文件名和长度，按 4 KB 擦除 W25Q32 暂存扇区。',
        status: '接收中',
        done: '已接收',
      },
      {
        node: 'ext',
        link: 'boot-ext',
        title: '写入外部 Flash',
        log: 'SPI1 按 256 字节页写入，加密包暂存到 W25Q32。',
        status: '暂存完成',
        done: '已暂存',
        fill: 'ext',
      },
      {
        node: 'boot',
        link: 'boot-ext',
        direction: 'up',
        title: '读取并解密',
        log: '从 W25Q32 读回头，解析原始长度，沿同一条 CBC 链 AES 解密。',
        status: '解密中',
        done: '已解密',
      },
      {
        node: 'int',
        link: 'ext-int',
        title: '写入内部 Flash',
        log: '擦除 APP 页，按半字写入 0x08008000；奇数长度末字节补 0xFF。',
        status: '写入完成',
        done: '已写入',
        fill: 'int',
      },
      {
        node: 'int',
        title: '读回比对',
        log: '逐半字读回比较，确认写入值与本次解密输出一致。',
        status: '比对通过',
        done: '已比对',
      },
      {
        node: 'boot',
        title: '向量表检查',
        log: '检查初始 MSP、复位入口和 Thumb 位，设置 VTOR = 0x08008000。',
        status: '检查通过',
        done: '已检查',
      },
      {
        node: 'app',
        link: 'int-app',
        title: '跳转并运行',
        log: '关闭中断与 SysTick，设置 MSP，跳转 APP；LED 开始闪烁。',
        status: '运行中',
        done: '运行中',
      },
    ];

    let index = 0;
    let playing = false;
    let timer = null;
    let started = false;

    const setStatus = (key, text) => {
      const status = nodes[key]?.querySelector('[data-status]');
      if (status) status.textContent = text;
    };

    const clearLinks = () => {
      for (const link of Object.values(links)) {
        link.classList.remove('is-running', 'up');
        const packet = link.querySelector('.ota-packet');
        if (packet) packet.style.animation = 'none';
      }
    };

    const updateButtons = () => {
      playBtn.textContent = playing
        ? '暂停'
        : index >= steps.length
          ? '重播'
          : '播放';
    };

    const setProgress = (value) => {
      progressEl.style.width = `${value}%`;
    };

    const reset = () => {
      playing = false;
      clearTimeout(timer);
      index = 0;
      titleEl.textContent = '待开始';
      setProgress(0);
      logEl.innerHTML = '';

      for (const node of Object.values(nodes)) {
        node.classList.remove('is-active', 'is-done');
        const status = node.querySelector('[data-status]');
        if (status) status.textContent = '等待';
      }

      root.querySelectorAll('[data-fill]').forEach((fill) => {
        fill.style.width = '0%';
      });

      clearLinks();
      updateButtons();
    };

    const render = (stepIndex) => {
      const step = steps[stepIndex];

      const previous = steps[stepIndex - 1];

      for (const node of Object.values(nodes)) {
        if (node.classList.contains('is-active')) {
          node.classList.remove('is-active');
          node.classList.add('is-done');
        }
      }

      if (previous?.done) setStatus(previous.node, previous.done);

      nodes[step.node].classList.add('is-active');
      titleEl.textContent = `${stepIndex + 1}/${steps.length} · ${step.title}`;
      setProgress(((stepIndex + 1) / steps.length) * 100);

      if (step.status) setStatus(step.node, step.status);

      const item = document.createElement('li');
      const number = document.createElement('span');
      number.textContent = String(stepIndex + 1).padStart(2, '0');
      item.append(number, document.createTextNode(step.log));
      logEl.append(item);
      logEl.scrollTop = logEl.scrollHeight;

      if (step.fill) {
        const fill = root.querySelector(`[data-fill="${step.fill}"]`);
        if (fill) fill.style.width = '100%';
      }

      clearLinks();

      if (step.link) {
        const link = links[step.link];
        if (link) {
          link.classList.add('is-running');
          if (step.direction === 'up') link.classList.add('up');

          const packet = link.querySelector('.ota-packet');
          if (packet) {
            packet.style.animation = 'none';
            void packet.offsetWidth;
            packet.style.animation = '';
          }
        }
      }
    };

    const finish = () => {
      playing = false;
      clearTimeout(timer);
      titleEl.textContent = '升级完成';
      setProgress(100);

      const last = steps[steps.length - 1];
      if (last?.done) setStatus(last.node, last.done);

      for (const node of Object.values(nodes)) {
        if (node.classList.contains('is-active')) {
          node.classList.remove('is-active');
          node.classList.add('is-done');
        }
      }

      updateButtons();
    };

    const next = () => {
      if (index >= steps.length) {
        finish();
        return;
      }

      const current = index;
      index += 1;
      render(current);
      updateButtons();

      if (playing) {
        timer = setTimeout(next, reduced ? 500 : 1700);
      }
    };

    playBtn.addEventListener('click', () => {
      started = true;

      if (playing) {
        playing = false;
        clearTimeout(timer);
        updateButtons();
        return;
      }

      if (index >= steps.length) reset();
      playing = true;
      updateButtons();
      next();
    });

    stepBtn.addEventListener('click', () => {
      started = true;
      playing = false;
      clearTimeout(timer);

      if (index >= steps.length) reset();
      const current = index;
      index += 1;
      render(current);
      updateButtons();
    });

    resetBtn.addEventListener('click', () => {
      started = true;
      reset();
    });

    reset();

    if (!reduced) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!started && entries.some((entry) => entry.isIntersecting)) {
            started = true;
            observer.disconnect();
            playBtn.click();
          }
        },
        { threshold: 0.35 },
      );

      observer.observe(root);
    }
  }
</script>

<style>
  .ota-demo {
    margin-top: 1.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(180deg, #11141b 0%, #0d1016 100%);
  }

  .ota-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ota-kicker {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--gold);
  }

  .ota-step-title {
    margin-top: 0.3rem;
    font-size: 0.92rem;
    color: var(--text);
  }

  .ota-controls {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .ota-btn {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #151a23;
    color: var(--dim);
    font-family: var(--sans);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .ota-btn:hover {
    color: var(--text);
    border-color: #3a4152;
  }

  .ota-btn-primary {
    border-color: rgba(232, 185, 106, 0.5);
    background: rgba(232, 185, 106, 0.06);
    color: var(--gold);
  }

  .ota-progress {
    height: 2px;
    margin-top: 1rem;
    overflow: hidden;
    border-radius: 1px;
    background: var(--line);
  }

  .ota-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--gold);
    transition: width 0.4s ease;
  }

  .ota-flow {
    max-width: 34rem;
    margin: 1.25rem auto 0;
  }

  .ota-node {
    position: relative;
    padding: 0.8rem 1rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #11141b;
    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .ota-node.is-active {
    border-color: var(--gold);
    background: rgba(232, 185, 106, 0.05);
    box-shadow: 0 0 30px -14px rgba(232, 185, 106, 0.8);
  }

  .ota-node.is-done {
    border-color: rgba(232, 185, 106, 0.18);
  }

  .ota-node-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .ota-node-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .ota-node-tag {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--gold-dim);
  }

  .ota-node-meta {
    margin-top: 0.2rem;
    font-size: 0.68rem;
    color: var(--faint);
  }

  .ota-node-status {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--faint);
  }

  .ota-node.is-active .ota-node-status {
    color: var(--gold);
  }

  .ota-meter {
    height: 3px;
    margin-top: 0.55rem;
    overflow: hidden;
    border-radius: 2px;
    background: #1d222d;
  }

  .ota-meter span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--gold);
    transition: width 0.8s ease;
  }

  .ota-link {
    position: relative;
    height: 44px;
    margin-left: 26px;
    border-left: 1px dashed #2a2f3b;
  }

  .ota-link-label {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    font-size: 0.63rem;
    color: var(--faint);
  }

  .ota-packet {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 12px rgba(232, 185, 106, 0.9);
    opacity: 0;
  }

  .ota-link.is-running {
    border-left-color: rgba(232, 185, 106, 0.45);
  }

  .ota-link.is-running .ota-packet {
    opacity: 1;
    animation: ota-flow-down 0.9s ease-in-out forwards;
  }

  .ota-link.is-running.up .ota-packet {
    animation-name: ota-flow-up;
  }

  @keyframes ota-flow-down {
    from {
      top: -4px;
    }
    to {
      top: calc(100% - 4px);
    }
  }

  @keyframes ota-flow-up {
    from {
      top: calc(100% - 4px);
    }
    to {
      top: -4px;
    }
  }

  .ota-log-wrap {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .ota-log-title {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--faint);
  }

  .ota-log {
