<div class="ota-anim" data-ota-anim>
  <div class="ota-anim-head">
    <div>
      <span class="ota-anim-kicker">外部 Flash 路径</span>
      <p class="ota-anim-caption" data-caption>准备中</p>
    </div>
    <button type="button" class="ota-anim-btn" data-replay>重播</button>
  </div>

  <div class="ota-anim-stage">
    <div class="ota-source">
      <div class="ota-chip">
        <span class="ota-chip-name">上位机</span>
        <span class="ota-chip-meta">BIN → AES 加密包</span>
      </div>
      <div class="ota-package" data-package aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="ota-wire" data-wire="send">
      <span class="ota-wire-label">USART1 · YMODEM</span>
      <i class="ota-byte"></i><i class="ota-byte"></i><i class="ota-byte"></i>
    </div>

    <div class="ota-memory" data-memory="ext">
      <div class="ota-memory-head">
        <span class="ota-memory-name">W25Q32 · 外部 Flash</span>
        <span class="ota-memory-meta">4 MB · 4 KB 扇区</span>
      </div>
      <div class="ota-cells" data-cells="ext" aria-hidden="true">
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
      </div>
      <div class="ota-memory-foot">
        <span data-ext-status>空</span>
        <span>暂存加密包</span>
      </div>
    </div>

    <div class="ota-wire ota-wire-aes" data-wire="decrypt">
      <span class="ota-lock" data-lock aria-hidden="true"><i></i></span>
      <span class="ota-wire-label">读取 · AES-256-CBC 解密</span>
      <i class="ota-byte"></i><i class="ota-byte"></i><i class="ota-byte"></i>
    </div>

    <div class="ota-memory" data-memory="int">
      <div class="ota-memory-head">
        <span class="ota-memory-name">内部 Flash · APP 区</span>
        <span class="ota-memory-meta">0x08008000 · 96 KB</span>
      </div>
      <div class="ota-cells ota-cells-int" data-cells="int" aria-hidden="true">
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
        <span class="ota-cell"></span><span class="ota-cell"></span>
      </div>
      <div class="ota-memory-foot">
        <span data-int-status>旧 APP</span>
        <span>解密后的固件</span>
      </div>
    </div>

    <div class="ota-wire" data-wire="jump">
      <span class="ota-wire-label">校验向量表 · 设置 VTOR / MSP</span>
      <i class="ota-byte"></i><i class="ota-byte"></i>
    </div>

    <div class="ota-app" data-app>
      <div>
        <span class="ota-app-name">APP 运行</span>
        <span class="ota-app-meta">_LED1 · LED2 / LED3</span>
      </div>
      <div class="ota-app-signals">
        <span class="ota-check" data-check>✓</span>
        <i class="ota-led" data-led></i>
      </div>
    </div>
  </div>

  <div class="ota-anim-foot">
    <p class="ota-anim-note">
      按最终路径简化；当前代码尚未校验 YMODEM CRC。
    </p>
    <div class="ota-anim-progress" aria-hidden="true">
      <span data-progress></span>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector('[data-ota-anim]');

  if (root) {
    const caption = root.querySelector('[data-caption]');
    const replayBtn = root.querySelector('[data-replay]');
    const packageEl = root.querySelector('[data-package]');
    const extCells = [
      ...root.querySelectorAll('[data-cells="ext"] .ota-cell'),
    ];
    const intCells = [
      ...root.querySelectorAll('[data-cells="int"] .ota-cell'),
    ];
    const extStatus = root.querySelector('[data-ext-status]');
    const intStatus = root.querySelector('[data-int-status]');
    const progress = root.querySelector('[data-progress]');
    const lock = root.querySelector('[data-lock]');
    const check = root.querySelector('[data-check]');
    const led = root.querySelector('[data-led]');
    const wires = Object.fromEntries(
      [...root.querySelectorAll('[data-wire]')].map((wire) => [
        wire.dataset.wire,
        wire,
      ]),
    );
    const memoryEls = {
      ext: root.querySelector('[data-memory="ext"]'),
      int: root.querySelector('[data-memory="int"]'),
      app: root.querySelector('[data-app]'),
    };

    let token = 0;

    const sleep = (ms, id) =>
      new Promise((resolve, reject) => {
        setTimeout(() => {
          if (id === token) resolve();
          else reject(new Error('cancelled'));
        }, ms);
      });

    const setWire = (name, on) => {
      wires[name]?.classList.toggle('is-active', on);
    };

    const setMemory = (name, on) => {
      memoryEls[name]?.classList.toggle('is-active', on);
    };

    const resetUI = () => {
      for (const cell of [...extCells, ...intCells]) {
        cell.classList.remove('is-filled');
      }

      packageEl.classList.remove('is-sending');

      for (const wire of Object.values(wires)) {
        wire.classList.remove('is-active');
      }

      for (const memory of Object.values(memoryEls)) {
        memory?.classList.remove('is-active');
      }

      lock.classList.remove('is-open');
      check.classList.remove('is-visible');
      led.classList.remove('is-on');
      extStatus.textContent = '空';
      intStatus.textContent = '旧 APP';
      caption.textContent = '准备中';
      progress.style.width = '0%';
    };

    const play = async () => {
      const id = ++token;
      resetUI();

      try {
        caption.textContent = '串口写入外部 Flash';
        packageEl.classList.add('is-sending');
        setMemory('ext', true);
        setWire('send', true);

        for (let index = 0; index < extCells.length; index += 1) {
          await sleep(110, id);
          extCells[index].classList.add('is-filled');
          extStatus.textContent = `写入 ${index + 1}/${extCells.length}`;
          progress.style.width = `${((index + 1) / extCells.length) * 35}%`;
        }

        packageEl.classList.remove('is-sending');
        setWire('send', false);

        caption.textContent = '读取并解密 · AES-256-CBC';
        lock.classList.add('is-open');
        setWire('decrypt', true);
        await sleep(1500, id);
        setWire('decrypt', false);
        setMemory('ext', false);

        caption.textContent = '写入内部 Flash · APP 区';
        setMemory('int', true);
        setWire('decrypt', true);

        for (let index = 0; index < intCells.length; index += 1) {
          await sleep(160, id);
          intCells[index].classList.add('is-filled');
          intStatus.textContent = `写入 ${index + 1}/${intCells.length}`;
          progress.style.width = `${55 + ((index + 1) / intCells.length) * 30}%`;
        }

        setWire('decrypt', false);

        caption.textContent = '校验向量表 · 跳转 APP';
        setWire('jump', true);
        await sleep(700, id);
        setWire('jump', false);
        check.classList.add('is-visible');
        intStatus.textContent = '校验通过';
        setMemory('app', true);
        led.classList.add('is-on');
        progress.style.width = '92%';

        caption.textContent = 'APP 运行 · LED 闪烁';
        await sleep(2200, id);
        progress.style.width = '100%';
        await sleep(1600, id);
        play();
      } catch {
        // 重播时取消上一轮
      }
    };

    replayBtn.addEventListener('click', () => {
      play();
    });

    play();
  }
</script>

<style>
  .ota-anim {
    margin-top: 1.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(180deg, #11141b 0%, #0d1016 100%);
  }

  .ota-anim-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ota-anim-kicker {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--gold);
  }

  .ota-anim-caption {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  .ota-anim-btn {
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(232, 185, 106, 0.45);
    border-radius: 7px;
    background: rgba(232, 185, 106, 0.05);
    color: var(--gold);
    font-family: var(--sans);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .ota-anim-btn:hover {
    background: rgba(232, 185, 106, 0.12);
  }

  .ota-anim-stage {
    max-width: 37rem;
    margin: 1.25rem auto 0;
  }

  .ota-source {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #11141b;
    flex-wrap: wrap;
  }

  .ota-chip-name {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .ota-chip-meta {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--faint);
  }

  .ota-package {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 3px;
    width: 160px;
  }

  .ota-package span {
    height: 14px;
    border-radius: 2px;
    background: #1d222d;
  }

  .ota-package.is-sending span {
    animation: package-pulse 0.9s ease-in-out infinite;
  }

  .ota-package span:nth-child(2) { animation-delay: 0.06s; }
  .ota-package span:nth-child(3) { animation-delay: 0.12s; }
  .ota-package span:nth-child(4) { animation-delay: 0.18s; }
  .ota-package span:nth-child(5) { animation-delay: 0.24s; }
  .ota-package span:nth-child(6) { animation-delay: 0.3s; }
  .ota-package span:nth-child(7) { animation-delay: 0.36s; }
  .ota-package span:nth-child(8) { animation-delay: 0.42s; }

  .ota-wire {
    position: relative;
    height: 48px;
    margin-left: 26px;
    border-left: 1px dashed #2a2f3b;
  }

  .ota-wire.is-active {
    border-left-color: rgba(232, 185, 106, 0.45);
  }

  .ota-wire-label {
    position: absolute;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    font-size: 0.62rem;
    color: var(--faint);
  }

  .ota-wire-aes .ota-wire-label {
    left: 26px;
  }

  .ota-byte {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 1px;
    background: var(--gold);
    opacity: 0;
  }

  .ota-wire.is-active .ota-byte {
    opacity: 1;
    animation: wire-fall 0.9s linear infinite;
  }

  .ota-wire .ota-byte:nth-of-type(2) {
    animation-delay: 0.3s;
  }

  .ota-wire .ota-byte:nth-of-type(3) {
    animation-delay: 0.6s;
  }

  .ota-lock {
    position: absolute;
    top: 50%;
    left: -15px;
    width: 28px;
    height: 24px;
    margin-top: -12px;
    border: 2px solid var(--gold-dim);
    border-radius: 5px;
    background: var(--bg);
    transition: border-color 0.3s ease;
  }

  .ota-lock::before {
    content: "";
    position: absolute;
    top: -11px;
    left: 5px;
    width: 14px;
    height: 11px;
    border: 2px solid var(--gold-dim);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    transform-origin: bottom left;
    transition:
      transform 0.35s ease,
      border-color 0.3s ease;
  }

  .ota-lock::after {
    content: "";
    position: absolute;
    top: 9px;
    left: 11px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold-dim);
  }

  .ota-lock.is-open {
    border-color: var(--gold);
  }

  .ota-lock.is-open::before {
    border-color: var(--gold);
    transform: rotate(-38deg) translateX(1px);
  }

  .ota-memory {
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #11141b;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .ota-memory.is-active {
    border-color: rgba(232, 185, 106, 0.6);
    box-shadow: 0 0 30px -16px rgba(232, 185, 106, 0.9);
  }

  .ota-memory-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ota-memory-name {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text);
  }

  .ota-memory-meta {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--faint);
  }

  .ota-cells {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
    margin-top: 0.6rem;
  }

  .ota-cells-int {
    grid-template-columns: repeat(4, 1fr);
  }

  .ota-cell {
    height: 12px;
    border-radius: 2px;
    background: #1d222d;
    transition:
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .ota-cell.is-filled {
    background: linear-gradient(180deg, #f0c87e, #c8953f);
    box-shadow: 0 0 8px rgba(232, 185, 106, 0.45);
    animation: cell-pop 0.2s ease-out;
  }

  .ota-memory-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.55rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--faint);
  }

  .ota-app {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #11141b;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .ota-app.is-active {
    border-color: rgba(232, 185, 106, 0.65);
    box-shadow: 0 0 30px -14px rgba(232, 185, 106, 0.8);
  }

  .ota-app-name {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .ota-app-meta {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--faint);
  }

  .ota-app-signals {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ota-check {
    color: var(--gold);
    font-size: 1.1rem;
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .ota-check.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .ota-led {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2a2f3b;
  }

  .ota-led.is-on {
    background: #9ece6a;
    box-shadow: 0 0 12px #9ece6a;
    animation: led-blink 0.9s steps(2, start) infinite;
  }

  .ota-anim-foot {
    max-width: 37rem;
    margin: 1rem auto 0;
  }

  .ota-anim-note {
    font-size: 0.64rem;
    line-height: 1.6;
    color: var(--faint);
  }

  .ota-anim-progress {
    height: 2px;
    margin-top: 0.6rem;
    overflow: hidden;
    border-radius: 1px;
    background: var(--line);
  }

  .ota-anim-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--gold);
    transition: width 0.2s linear;
  }

  @keyframes package-pulse {
    0%,
    100% {
      background: #1d222d;
    }
    50% {
      background: var(--gold);
      box-shadow: 0 0 8px rgba(232, 185, 106, 0.5);
    }
  }

  @keyframes wire-fall {
    0% {
      top: -4px;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 4px);
      opacity: 0;
    }
  }

  @keyframes cell-pop {
    from {
      transform: scale(0.85);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes led-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.45;
    }
  }

  @media (max-width: 560px) {
    .ota-source {
      align-items: flex-start;
      flex-direction: column;
    }

    .ota-package {
      width: 100%;
    }

    .ota-wire {
      height: 40px;
    }

    .ota-cell {
      height: 10px;
    }
  }
</style>
