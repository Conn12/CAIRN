---
import type { CollectionEntry } from 'astro:content';
import PostList from './post-list.astro';
import { formatDate } from '../utils/date';

interface Props {
  posts: CollectionEntry<'posts'>[];
  currentId?: string;
}

const { posts, currentId } = Astro.props;
const latest = posts[0];
---

<aside class="sidebar">
  <div class="sidebar-head">
    <a class="logo" href="/">CAIRN</a>
    <p class="tagline">一路走，一路堆石头</p>
  </div>

  <details class="sidebar-mobile">
    <summary>
      <span>文章目录</span>
      <span class="count">{posts.length}</span>
    </summary>
    <nav aria-label="文章目录">
      <PostList posts={posts} currentId={currentId} />
    </nav>
  </details>

  <nav class="sidebar-nav" aria-label="文章目录">
    <p class="nav-label">
      <span>文章</span>
      <span class="count">{posts.length}</span>
    </p>
    <PostList posts={posts} currentId={currentId} />
  </nav>

  <div class="sidebar-foot">
    {
      latest
        ? `最后更新 ${formatDate(latest.data.date)}`
        : '还没有文章'
    }
  </div>
</aside>
