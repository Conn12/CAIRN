---
import type { CollectionEntry } from 'astro:content';
import PostList from './post-list.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  currentId?: string;
}

const { posts, currentId } = Astro.props;
---

<aside class="sidebar">
  <details class="sidebar-mobile">
    <summary>
      <span>文章目录</span>
      <span class="count">{posts.length}</span>
    </summary>
    <nav aria-label="文章目录">
      <PostList posts={posts} currentId={currentId} />
    </nav>
  </details>

  <nav class="sidebar-nav" aria-label="文章目录">
    <p class="nav-label">
      <span>文章</span>
      <span class="count">{posts.length}</span>
    </p>
    <PostList posts={posts} currentId={currentId} />
  </nav>
</aside>
