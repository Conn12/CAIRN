---
import LearningNav from './learning-nav.astro';

interface Project {
  slug: string;
  title: string;
  sub: string;
  chapters: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<aside class="sidebar">
  <details class="sidebar-mobile">
    <summary>
      <span>学习目录</span>
      <span class="count">{projects.length}</span>
    </summary>
    <nav aria-label="学习目录">
      <LearningNav projects={projects} />
    </nav>
  </details>

  <nav class="sidebar-nav" aria-label="学习目录">
    <p class="nav-label">
      <span>学习</span>
      <span class="count">{projects.length}</span>
    </p>
    <LearningNav projects={projects} />
  </nav>
</aside>
