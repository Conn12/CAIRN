---
interface Props {
  image: any;
  caption: string;
  alt?: string;
}

const { image: Illustration, caption, alt } = Astro.props;
---

<figure class="share-figure">
  <Illustration role="img" aria-label={alt ?? caption} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .share-figure {
    margin: 0;
  }

  .share-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #0b0d11;
  }

  .share-figure figcaption {
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--faint);
    letter-spacing: 0.04em;
  }
</style>
