---
import Base from '../layouts/base.astro';
import LearningSidebar from '../components/learning-sidebar.astro';
import OtaDemo from '../components/ota-demo.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('learning')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const projects = await Promise.all(
  entries.map(async (entry) => {
    const { Content, headings } = await render(entry);
    return {
      entry,
      Content,
      chapters: headings.filter((heading) => heading.depth === 2),
    };
  }),
);

const sidebarProjects = projects.map(({ entry, chapters }) => ({
  slug: entry.id,
  title: entry.data.title,
  sub: entry.data.sub,
  chapters: chapters.map((chapter) => chapter.text),
}));

const demos: Record<string, any> = { ota: OtaDemo };
const meta = `${projects.length} 个项目`;
---

<Base
  title="学习"
  description="项目笔记：把做出来的东西讲清楚，不只记录步骤。"
  section="learning"
  meta={meta}
>
  <LearningSidebar projects={sidebarProjects} slot="sidebar" />

  <div class="learning-index">
    <p class="learning-kicker">学习 / 项目笔记</p>
    <h1>做出来，再把路径讲清楚。</h1>
    <p class="learning-lede">
      不按版本流水账，只总结每个项目最终怎么跑通、为什么这样做。
    </p>
  </div>

  {
    projects.map(({ entry, Content }, index) => {
      const Demo = entry.data.demo ? demos[entry.data.demo] : null;

      return (
        <article
          class:list={['learning-view', { 'is-active': index === 0 }]}
          id={entry.id}
          data-learning-view
        >
          <header class="learning-header">
            <p class="learning-kicker">{entry.data.status || '项目'}</p>
            <h1>{entry.data.title}</h1>
            <p class="learning-lede">{entry.data.summary}</p>
            <div class="learning-tags">
              {entry.data.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </header>

          <div class="prose learning-prose">
            <Content />
          </div>

          {Demo && (
            <div class="learning-demo">
              <Demo />
            </div>
          )}
        </article>
      );
    })
  }
</Base>

<script>
  const views = [...document.querySelectorAll('[data-learning-view]')];
  const groups = [...document.querySelectorAll('[data-learning-group]')];
  const projectLinks = [...document.querySelectorAll('[data-learning-project]')];
  const chapterButtons = [...document.querySelectorAll('[data-chapter-project]')];

  if (views.length > 0) {
    const firstSlug = views[0].id;
    const activeView = () =>
      views.find((view) => view.classList.contains('is-active')) ?? views[0];

    const setChapterActive = (index) => {
      const slug = activeView().id;
      for (const button of chapterButtons) {
        if (button.dataset.chapterProject !== slug) continue;
        button.classList.toggle(
          'active',
          Number(button.dataset.chapterIndex) === index,
        );
      }
    };

    const updateActiveChapter = () => {
      const view = activeView();
      const headings = [...view.querySelectorAll('.learning-prose h2')];
      if (headings.length === 0) return;

      let current = 0;
      for (const [index, heading] of headings.entries()) {
        if (heading.getBoundingClientRect().top <= 140) current = index;
      }

      setChapterActive(current);
    };

    const activate = (slug) => {
      const target =
        views.find((view) => view.id === slug) ?? views[0];

      for (const view of views) {
        view.classList.toggle('is-active', view === target);
      }

      for (const group of groups) {
        group.classList.toggle(
          'is-active',
          group.dataset.learningGroup === target.id,
        );
      }

      for (const link of projectLinks) {
        const active = link.dataset.learningProject === target.id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }

      for (const button of chapterButtons) {
        button.classList.remove('active');
      }

      return target;
    };

    const fromHash = () => {
      const slug = decodeURIComponent(location.hash.slice(1));
      return views.some((view) => view.id === slug) ? slug : firstSlug;
    };

    activate(fromHash());

    if (location.hash) {
      requestAnimationFrame(() => {
        document.getElementById(fromHash())?.scrollIntoView();
      });
    }

    window.addEventListener('hashchange', () => {
      activate(fromHash());
    });

    for (const link of projectLinks) {
      link.addEventListener('click', () => {
        activate(link.dataset.learningProject);
      });
    }

    for (const button of chapterButtons) {
      button.addEventListener('click', () => {
        const view = activeView();
        if (button.dataset.chapterProject !== view.id) return;

        const headings = [...view.querySelectorAll('.learning-prose h2')];
        const target = headings[Number(button.dataset.chapterIndex)];
        if (target) target.scrollIntoView({ block: 'start' });
        setChapterActive(Number(button.dataset.chapterIndex));
      });
    }

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          updateActiveChapter();
        });
      },
      { passive: true },
    );

    updateActiveChapter();
  }
</script>
